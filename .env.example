# Local development defaults. Change all secrets before deployment.
DB_PASSWORD=gapmap_local
MYSQL_ROOT_PASSWORD=gapmap_root_local
JWT_SECRET=local-demo-change-this-secret-before-production-123456789
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TEACHER_INVITE_CODE=GAPMAP-TEACHER
SEED_DATA=true
SEED_PASSWORD=GapMap123!
# No mail server is bundled: with this on, password reset links are written to the backend log.
# Turn it off (or wire up email) before real use.
RESET_LINKS_IN_LOG=true
RESET_TOKEN_MINUTES=30

# Supabase profile ONLY: supply these through the backend process environment or
# deployment secret store. Spring Boot does not automatically load this .env file.
# Do not activate demo and supabase together. No real credentials belong here.
# SPRING_PROFILES_ACTIVE=supabase
# SUPABASE_DB_URL=jdbc:postgresql://<approved-host>:5432/postgres?sslmode=verify-full&sslrootcert=<absolute-certificate-path>
# SUPABASE_DB_USER=gapmap_app.<project-ref>
# SUPABASE_DB_PASSWORD=<runtime-login-secret>
# Runtime Flyway is disabled. Do not supply migration credentials to the backend.
# SUPABASE_DB_POOL_SIZE=5
# Also replace JWT_SECRET, TEACHER_INVITE_CODE and FRONTEND_ORIGIN above with
# deployment-specific values; use an HTTPS frontend and a random JWT secret
# of at least 32 characters. Never reuse the local demo defaults for deployment.
